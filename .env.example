# OpenArt API Configuration
# Obtenha sua chave em: https://openart.ai/api
OPENART_API_KEY=your_openart_api_key_here

# OpenArt API Settings
OPENART_BASE_URL=https://api.openart.ai/v1
OPENART_TIMEOUT=30000
OPENART_MAX_RETRIES=3

# PixelLab API Configuration
# Documentação: https://api.pixellab.ai/v2/docs
PIXELLAB_API_KEY=sua_chave_aqui

# PixelLab API Settings
PIXELLAB_BASE_URL=https://api.pixellab.ai/v2
PIXELLAB_TIMEOUT=30000
PIXELLAB_MAX_RETRIES=3

# Asset Manager Settings
ASSET_BASE_PATH=/assets
ASSET_USE_INDEXEDDB=true
ASSET_MAX_CACHE_SIZE=50

# Sprite Generation Defaults
SPRITE_DEFAULT_STYLE=pixel-art
SPRITE_DEFAULT_WIDTH=64
SPRITE_DEFAULT_HEIGHT=64
SPRITE_DEFAULT_STEPS=40
SPRITE_DEFAULT_GUIDANCE_SCALE=8.5

# Development Settings
NODE_ENV=development
