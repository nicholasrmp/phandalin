# Cabeçalhos do Cloudflare Pages.
# Este arquivo é copiado para a raiz do build (public/ → dist/).

# Os assets do Vite têm hash no nome: são imutáveis, podem ficar em cache para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML sempre revalida, para que uma versão nova apareça na hora.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
